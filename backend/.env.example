# ============================================================
# LIMSS - Variables de entorno
# Copiar a .env y completar con valores reales
# ============================================================

# --- Base de datos ERP GI_LX (solo lectura) ---
ERP_DB_SERVER=LAMARSERVER
ERP_DB_NAME=GI_LX
ERP_DB_USER=ebr_readonly
ERP_DB_PASSWORD=cambiar_esto
ERP_DB_DRIVER=ODBC Driver 17 for SQL Server

# --- Base de datos LIMSS (lectura/escritura) ---
LIMSS_DB_SERVER=LAMARSERVER
LIMSS_DB_NAME=LIMSS
LIMSS_DB_USER=limss_app
LIMSS_DB_PASSWORD=cambiar_esto
LIMSS_DB_DRIVER=ODBC Driver 17 for SQL Server

# --- Base de datos eBR (solo lectura -- lotes internos de Granel/Semi-Elaborado/PT) ---
EBR_DB_SERVER=LAMARSERVER
EBR_DB_NAME=eBR_Veterinario
EBR_DB_USER=cambiar_esto
EBR_DB_PASSWORD=cambiar_esto
EBR_DB_DRIVER=ODBC Driver 17 for SQL Server

# --- Seguridad JWT ---
JWT_SECRET_KEY=cambiar_por_clave_aleatoria_segura_de_32_chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# --- Sesión ---
SESSION_TIMEOUT_MINUTES=10

# --- Sincronización de usuarios con el eBR (GET /api/auth/usuarios-ebr) ---
EBR_SYNC_API_KEY=cambiar_por_clave_aleatoria_segura

# --- Storage de archivos (PDFs de testigos, protocolos, etc.) ---
STORAGE_PATH=\\LAMARSERVER\LIMSS\storage

# --- App ---
APP_NAME=LIMSS Laboratorio Lamar
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8002
ALLOWED_ORIGINS=http://localhost:5174
